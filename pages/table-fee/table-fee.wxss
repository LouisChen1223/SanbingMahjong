.container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 48rpx;
  background: #f0f2f5;
  box-sizing: border-box;
}

.rule-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.rule-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.rule-text,
.rule-note {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.rule-note {
  color: #999;
  margin-top: 12rpx;
  margin-bottom: 0;
}

.picker-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.picker-label {
  display: block;
  font-size: 26rpx;
  color: #888;
  margin-bottom: 12rpx;
}

.picker-value {
  font-size: 30rpx;
  color: #1AAD19;
  padding: 16rpx 0;
}

.hint {
  text-align: center;
  color: #999;
  padding: 40rpx;
  font-size: 28rpx;
}

.summary-card {
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.summary-line {
  font-size: 30rpx;
  display: block;
}

.sum-money {
  font-size: 40rpx;
  font-weight: bold;
}

.summary-sub {
  display: block;
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

.table-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.table-head {
  background: #f5f5f5;
  font-weight: bold;
  color: #333;
}

.row {
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
  border-bottom: 1rpx solid #eee;
}

.row:last-child {
  border-bottom: none;
}

.col.name {
  flex: 1.4;
}

.col.min {
  flex: 1;
  text-align: right;
}

.col.fee {
  flex: 1;
  text-align: right;
  color: #e64340;
  font-weight: bold;
}

.table-head .col.fee {
  color: #333;
}

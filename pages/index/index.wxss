/* index.wxss - 个人战录入（与团队战录入视觉一致） */
.container {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
  padding: 10rpx 0;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 50%;
}

.back-icon {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1;
}

.header-placeholder {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin: 0 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.input-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.player-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.player-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.player-label {
  width: 60rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
}

.name-input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}

.score-input-wrapper {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.sign-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
}

.sign-btn.positive {
  background: #e8f5e9;
  color: #4caf50;
}

.sign-btn.negative {
  background: #ffebee;
  color: #f44336;
}

.score-input {
  width: 100rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  text-align: center;
}

.score-suffix {
  font-size: 24rpx;
  color: #999;
}

.duration-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eee;
}

.duration-label {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.duration-input {
  width: 200rpx;
  text-align: right;
  background: #f5f5f5;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}

.settle-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin: 30rpx 0;
}

.settle-btn:active {
  opacity: 0.9;
}

.result-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
}

.result-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.result-score {
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
}

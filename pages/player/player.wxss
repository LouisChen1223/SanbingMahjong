/*pages/player/player.wxss - 个人赛选手个人主页样式*/
.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  padding: 20rpx 0;
}

.back-btn {
  position: absolute;
  left: 0;
  font-size: 28rpx;
  color: #1AAD19;
  padding: 10rpx 20rpx;
  border: 2rpx solid #1AAD19;
  border-radius: 30rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1AAD19;
}

.player-info-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.avatar-container {
  position: relative;
  display: inline-block;
  margin-bottom: 20rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #1AAD19;
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx dashed #1AAD19;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8f8f8;
}

.avatar-icon {
  font-size: 60rpx;
}

.avatar-edit-btn {
  position: absolute;
  bottom: -5rpx;
  right: -5rpx;
  background: #1AAD19;
  color: #fff;
  font-size: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  border: 3rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

.player-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.official-name-box {
  text-align: left;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 24rpx;
}

.official-label {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.official-input {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.official-save-btn {
  display: inline-block;
  background: #576b95;
  color: #fff;
  font-size: 26rpx;
  padding: 14rpx 36rpx;
  border-radius: 30rpx;
  margin-bottom: 12rpx;
}

.official-hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}

.stats-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.stats-block {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.total-block {
  border-top: 4rpx solid #576b95;
}

.block-header {
  margin-bottom: 24rpx;
}

.block-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.block-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #888;
}

.loading-box {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

.stat-value.score {
  font-size: 34rpx;
}

.stat-value.small {
  font-size: 30rpx;
}

.score-row {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.score-mini {
  flex: 1;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.action-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 10rpx;
  margin-bottom: 40rpx;
}

.action-btn {
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  padding: 22rpx 40rpx;
  border-radius: 50rpx;
}

.season-history-btn {
  background: #576b95;
  color: #fff;
  box-shadow: 0 4rpx 15rpx rgba(87, 107, 149, 0.3);
}

.history-btn {
  background: #1AAD19;
  color: #fff;
  box-shadow: 0 4rpx 15rpx rgba(26, 173, 25, 0.3);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
}

.stat-item {
  text-align: center;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #1AAD19;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #888;
}

.score-section {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.score-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.score-label {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 10rpx;
}

.score-value {
  font-size: 36rpx;
  font-weight: bold;
}

.score-value.positive {
  color: #1AAD19;
}

.score-value.negative {
  color: #E64340;
}

.recent-games-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.position-chart {
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.chart-canvas {
  width: 100%;
  height: 600rpx;
}

.position-list {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: 15rpx;
  justify-content: flex-start;
  overflow-x: auto;
  padding: 10rpx 0;
  -webkit-overflow-scrolling: touch;
}

.position-item {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
}

.position-1 {
  background: linear-gradient(135deg, #FFD700, #FFA500);
}

.position-2 {
  background: linear-gradient(135deg, #C0C0C0, #A8A8A8);
}

.position-3 {
  background: linear-gradient(135deg, #CD7F32, #B87333);
}

.position-4 {
  background: linear-gradient(135deg, #708090, #505050);
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #999;
}
